# VITE_LEADS_WEBHOOK_URL (opsional, disarankan):
# Endpoint penerima data lead dari form Konsultasi/Kontak.
# Bisa Google Apps Script (Deploy sebagai Web App), Formspree, Web3Forms,
# atau API sendiri. Menerima POST JSON.
# Jika kosong, form otomatis fallback: pengunjung diarahkan mengirim
# data lengkap via WhatsApp (pesan sudah terisi otomatis).
VITE_LEADS_WEBHOOK_URL=""

# Analytics (opsional, isi salah satu atau keduanya):
# Google Analytics 4 — Measurement ID (format G-XXXXXXXXXX)
VITE_GA4_ID=""

# Plausible Analytics — domain yang didaftarkan (contoh: keuva.shop)
VITE_PLAUSIBLE_DOMAIN=""

# Plausible self-hosted (opsional, default https://plausible.io)
VITE_PLAUSIBLE_HOST=""
